{
  "$schema": "https://schemas.designtokens.org/draft-2024",
  "_meta": { "version": "2.0.0", "wcag": "2.2 AA verified", "bodyTextMin": 14 },

  "color": {
    "primitive": {
      "neutral": {
        "50": "#FBF8F0", "100": "#F4EDD9", "200": "#E4D9BC", "300": "#CCBA90",
        "400": "#A89070", "500": "#806050", "600": "#604838", "700": "#403020",
        "800": "#281808", "900": "#160C04", "950": "#0A0602"
      },
      "red":   { "50":"#FEF0F0","100":"#FDDADA","300":"#F07070","500":"#C02830","700":"#8C1018","900":"#500810" },
      "blue":  { "50":"#F0F5FA","100":"#D4E8F4","300":"#88B8D8","500":"#245878","700":"#14405C","900":"#102840" },
      "amber": { "50":"#FEF6E0","100":"#FDEBC0","300":"#F0C060","500":"#A05808","700":"#6C3C00","900":"#3C2000" },
      "green": { "50":"#EEFAEE","100":"#CCF0CC","300":"#70C880","500":"#1E7838","700":"#0E5020","900":"#082818" },
      "teal":  { "50":"#E8FAF8","100":"#C0EEE8","300":"#60C8C0","500":"#14707C","700":"#0E4C56","900":"#082830" }
    }
  },

  "theme": {
    "light": {
      "bg":     { "default":"#F4EDD9","subtle":"#E4D9BC","strong":"#CCBA90","inverse":"#160C04" },
      "fg":     { "default":"#160C04","subtle":"#604838","muted":"#604838","inverse":"#F4EDD9" },
      "border": { "default":"#160C04","subtle":"#604838","focus":"#245878" },
      "interactive": {
        "primary":"#C02830","primaryHover":"#8C1018","primaryFg":"#FFFFFF",
        "secondary":"#245878","secondaryHover":"#14405C","secondaryFg":"#FFFFFF"
      },
      "status": {
        "success":"#1E7838","warning":"#A05808","error":"#C02830","info":"#245878",
        "successBg":"#EEFAEE","warningBg":"#FEF6E0","errorBg":"#FEF0F0","infoBg":"#F0F5FA"
      }
    },
    "dark": {
      "bg":     { "default":"#18100A","subtle":"#241A10","strong":"#302018","inverse":"#F4EDD9" },
      "fg":     { "default":"#F4EDD9","subtle":"#C8B090","muted":"#A89070","inverse":"#18100A" },
      "border": { "default":"#A89070","subtle":"#403020","focus":"#88B8D8" },
      "interactive": {
        "primary":"#E04848","primaryHover":"#F07070","primaryFg":"#18100A",
        "secondary":"#88B8D8","secondaryHover":"#B0D0E8","secondaryFg":"#18100A"
      },
      "status": {
        "success":"#70C880","warning":"#F0C060","error":"#F07070","info":"#88B8D8",
        "successBg":"#082818","warningBg":"#3C2000","errorBg":"#500810","infoBg":"#102840"
      }
    }
  },

  "spacing": {
    "0":0,"1":1,"2":2,"4":4,"8":8,"12":12,"16":16,"24":24,"32":32,"48":48,"64":64,"96":96,"128":128
  },

  "typography": {
    "fontFamily": { "mono": "GeistMono", "monoFallback": "Courier New" },
    "fontSize": {
      "xs":12, "sm":13, "md":14, "base":16, "lg":18, "xl":22,
      "2xl":28, "3xl":36, "4xl":48, "5xl":64
    },
    "fontWeight": { "regular":"400","medium":"500","bold":"700" },
    "lineHeight": { "tight":1.3,"normal":1.55,"relaxed":1.8 },
    "letterSpacing": { "normal":0,"wide":0.8,"wider":1.6,"widest":3.2 }
  },

  "borderWidth": { "1":1, "2":2, "4":4 },
  "borderRadius": { "none":0 },

  "shadow": {
    "sm": { "x":2,"y":2,"blur":0,"spread":0 },
    "md": { "x":3,"y":3,"blur":0,"spread":0 },
    "lg": { "x":4,"y":4,"blur":0,"spread":0 },
    "xl": { "x":6,"y":6,"blur":0,"spread":0 }
  },

  "accessibility": {
    "contrastRequirement": "WCAG 2.2 AA — 4.5:1 normal text, 3:1 large/UI",
    "minBodySize": 14,
    "minMetadataSize": 12,
    "removed2xs": "9px size removed; failed legibility threshold",
    "focusRing": { "width":3, "offset":2, "color":"borderFocus" }
  }
}
